# Copy to worker.env (git-ignored) on the GPU machine; run-worker.ps1 loads it.
#   AEROMIND_SERVER   the deployed app (railway domain list --service aeromind)
#   WORKER_TOKEN      same value as the WORKER_TOKEN variable of the Railway service
#   S3_*              railway bucket credentials --bucket aeromind-data
# Local GPU settings (YOLO_MODEL_PATH, COLMAP_PATH, VLM_URL, VLM_MODEL ...) are read from backend/.env as usual.
AEROMIND_SERVER=https://aeromind-production.up.railway.app
WORKER_TOKEN=
S3_BUCKET=
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_ADDRESSING=virtual
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
WORKER_NAME=gpu-workstation
