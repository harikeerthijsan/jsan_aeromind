DATABASE_URL=sqlite:///./tower_vision.db
CORS_ORIGINS=http://localhost:5173
ENABLE_DEMO_SEED=true
# Authentication: demo mode creates Admin, Manager, Inspector and Viewer accounts.
# Change this before any shared/staging deployment; hide credentials from the login page when not needed.
AUTH_DEMO_PASSWORD=AeroMind@123
AUTH_SHOW_DEMO_CREDENTIALS=true
# Production: disable demo seed and provide the first administrator credentials.
# AUTH_ADMIN_EMAIL=admin@example.com
# AUTH_ADMIN_NAME=AeroMind Admin
# AUTH_ADMIN_PASSWORD=replace-with-a-long-random-password
# AUTH_DISABLED=false
# Local and bucket layout: uploads/sites/<tower>/inspections/INS-xxxxxx/{images|videos|frames}/...
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=524288000
# YOLO asset detector (leave YOLO_MODEL_PATH empty to disable inference)
YOLO_MODEL_PATH=
YOLO_IMGSZ=1920
YOLO_CONF=0.25
YOLO_IOU=0.7
YOLO_MAX_DET=1000
# empty = auto (GPU 0 if available), or e.g. 0 / cpu
YOLO_DEVICE=
# run detection on every Nth video frame
YOLO_VID_STRIDE=30
# Manufacturer suggestions from a local vision-language model served by Ollama (empty VLM_MODEL disables)
VLM_URL=http://127.0.0.1:11434
VLM_MODEL=qwen3-vl:8b-instruct
# one-to-one structure comparison against reference photos; the thinking variant is slower but far more discriminating
VLM_COMPARE_MODEL=qwen3-vl:8b
VLM_TIMEOUT=300
# reference photos of known equipment for structure matching: <dir>/<class>/<Manufacturer>/*.jpg
VENDOR_REFERENCE_DIR=./vendor_refs
# classes that get manufacturer / product model tags
VENDOR_CLASSES=sector_antenna,microwave_dish
# video uploads are split into still frames for review: every Nth frame, at most this many per video
VIDEO_FRAME_STRIDE=30
VIDEO_MAX_FRAMES=300
# condition assessment: boxes smaller than this (px, shorter side) are reported Unknown instead of guessed
CONDITION_MIN_SIDE=48
# 3D reconstruction with COLMAP (https://colmap.github.io, BSD): path to colmap.exe of the Windows CUDA build
COLMAP_PATH=D:/tools/colmap/bin/colmap.exe
RECON_VIDEO_STRIDE=10
RECON_MAX_IMAGES=300
RECON_DENSE_MAX_SIZE=1600
